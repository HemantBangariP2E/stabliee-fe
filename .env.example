VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Kalp wallet API (Telegram bot + embedded wallet)
VITE_WALLET_API_URL=https://alpha-wallet-api.kalp.studio/
VITE_WALLET_API_KEY=your_open_api_key

# Telegram bot (chat only — see telegram/README.md)
TELEGRAM_BOT_TOKEN=

# Bot chain: eth-sepolia (default) | base-sepolia
STABLIEe_BOT_CHAIN=eth-sepolia
# Must match Stabliee app wallet (MPC + ownerAddress). Do not use SMART_WALLET unless you only have that type.
STABLIEe_WALLET_TYPE=MPC
# Optional override — defaults match Transactions.tsx:
# eth-sepolia  → 0x5aEC77A2CBE8ee9D359F965826BdDFa026DfFb38
# base-sepolia → 0x28bD35b56bfCa732C7DF2F2d08312169189605A8
# VITE_STABLE_TOKEN_ADDRESS=
# STABLE_TOKEN_SYMBOL=USDT

# Bot always uses send-transaction-with-fee (recipient + platform fee wallet).
# Fee wallets are hardcoded in telegram-bot/src/walletClient.js (override optional):
# STABLIEe_FEE_RECIPIENT=0xaAEd3fCdDEDA26F9AD0582698d9Be012e48D88aF
# STABLIEe_BOT_GAS_FEE_USDT=0.05
# STABLIEe_ETH_USD_PRICE=2500

VITE_ETH_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
VITE_ALCHEMY_KEY=
