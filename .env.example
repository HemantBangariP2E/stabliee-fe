# Copy to ".env" for local dev. On Netlify: Site settings → Environment variables → add each VITE_*.

# Required for user_logins, transactions, etc.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Kalp Wallet API (token transfer history). Default: https://alpha-wallet-api.kalp.studio
# VITE_KALP_WALLET_API_URL=https://alpha-wallet-api.kalp.studio

# Optional: Alchemy (if used)
# VITE_ALCHEMY_KEY=
